{
  "_README_NEW_CARGOS": [
    "How to add a custom cargo:",
    "1. Add an object to the new_cargos list below.",
    "2. copy_from = the vanilla cargo whose row gets cloned (template).",
    "3. new_id    = the new row's name. Recipes reference this string.",
    "4. display_source = OPTIONAL. Existing cargo whose StringTable label",
    "                    your new cargo borrows in the mission UI. Defaults",
    "                    to copy_from. Custom display labels need a separate",
    "                    StringTable asset that's not yet wired up.",
    "5. safety_dps = OPTIONAL emergency net. Adds the new cargo to the",
    "                inputs of the named VANILLA DP classes by editing",
    "                their CDO \u2014 which means every instance of that class",
    "                in Jeju advertises your cargo. Do not use it unless a",
    "                cargo genuinely has no consumer: every delivery point",
    "                here gets its recipes written to its own mod BP CDO,",
    "                so a cargo consumed by one of your own points already",
    "                has a real consumer and needs no vanilla coverage.",
    "6. Every other key on the entry is a UE cargo-row field name. Field",
    "                names are case-sensitive and must match the vanilla",
    "                cargo struct exactly. Run `python import_cargo_data.py`",
    "                to extract a vanilla cargo dump under",
    "                CargoImport/cargos/catalog.json \u2014 copy values 1:1.",
    "7. Recipes (in DP entries below) reference cargos by name. Vanilla and",
    "                new_id values are both valid; unknown names get logged",
    "                and dropped at registry-load time."
  ],
  "_NEW_CARGO_FIELDS": {
    "_": "Reference of every cargo-row field that the framework can set verbatim on a new_cargos entry. Type column matches the underlying UE property class \u2014 use the matching JSON literal type when you set a value. Vanilla examples are from the Fuel row.",
    "_payment": {
      "PaymentPer1Km": "Float \u2014 per-km payout. Only fires when MT's road-distance calc finds a marked road; offroad runs ignore this. Vanilla Fuel: 300.",
      "PaymentPer1KmMultiplierByMaxWeight": "Float \u2014 per-km value scales with the cargo's max weight by this factor. Vanilla Fuel: 2.",
      "PaymentSqrtRatio": "Float \u2014 sqrt-curve coefficient applied to the payout. 1.0 default; <1 flattens long-route payouts, >1 amplifies. Vanilla Fuel: 1.",
      "PaymentSqrtRatioMinCapcity": "Int \u2014 minimum capacity before the sqrt curve kicks in. Vanilla Fuel: 0. (Fractional JSON values get truncated; setter warns when that happens.)",
      "BasePayment": "Int64 \u2014 flat base payout independent of distance. THE offroad lever \u2014 bump this to make missions worth running on dirt roads. Vanilla Fuel: 100.",
      "ExportPrice": "Int \u2014 price when delivered to a Container_Export-style DP. Vanilla Fuel: 10.",
      "ImportPrice": "Int \u2014 price MT charges when this cargo is imported into a region. Vanilla Fuel: 10.",
      "MaxDamagePaymentMultiplier": "Float \u2014 payout cap for fully-damaged cargo (0..1). Vanilla Fuel: 0.1.",
      "DamageBonusMultiplier": "Float \u2014 bonus multiplier for delivering with no damage. Vanilla Fuel: 0.",
      "ManualLoadingPayment": "Int64 \u2014 extra pay when the player manually loads the cargo vs using a forklift. Vanilla Fuel: 0."
    },
    "_mission_gen": {
      "SpawnProbability": "Int \u2014 random/ambient mission generator weight. Higher = more frequent. Vanilla Fuel: 10.",
      "NumCargoMin": "Int \u2014 minimum units per generated mission. Vanilla Fuel: 5.",
      "NumCargoMax": "Int \u2014 maximum units per generated mission. Vanilla Fuel: 20.",
      "MinDeliveryDistance": "Float \u2014 mission gen filter, minimum km between source and destination. Vanilla Fuel: 1.",
      "MaxDeliveryDistance": "Float \u2014 mission gen filter, maximum km. 0 = unlimited. Vanilla Fuel: 0."
    },
    "_physical": {
      "VolumeSize": "Int \u2014 capacity-units the cargo occupies on a trailer. Vanilla Fuel: 1.",
      "bAllowStacking": "Bool \u2014 multiple units share one trailer slot. Vanilla Fuel: false.",
      "bUseDamage": "Bool \u2014 cargo accumulates damage from rough driving / collisions. Vanilla Fuel: false.",
      "Fragile": "Int \u2014 damage sensitivity (higher = breaks easier). Vanilla Fuel: 0.",
      "bHoldingOffsetUsingItemBounds": "Bool \u2014 render attachment offset uses the item's bounding box instead of a fixed pivot. Vanilla Fuel: false."
    },
    "_timer": {
      "bTimer": "Bool \u2014 whether the cargo has a delivery time limit / bonus. Vanilla Fuel: false.",
      "BaseTimeSeconds": "Float \u2014 baseline seconds for the timer. Vanilla Fuel: 0.",
      "TimerBySpeedKPH": "Float \u2014 timer scales with the player's average speed in km/h. Vanilla Fuel: 0.",
      "TimerByRoadSpeedLimitRatio": "Float \u2014 timer scales with the road's speed limit (1.0 = match the limit). Vanilla Fuel: 0."
    },
    "_meta": {
      "bDepcreated": "Bool \u2014 marks the cargo as legacy. May hide it from random mission gen depending on MT version. Vanilla Fuel: false."
    },
    "_NOT_supported_yet": {
      "_": "These exist on every cargo row but require array/struct/enum/object handling that the generic setter doesn't do. Touching them needs a one-off code path in MTBPInjector.MutateCargos.",
      "CargoType": "EnumProperty \u2014 single value (Box, Pallet, LiquidContainer, ...). Useful but not wired yet.",
      "CargoSpaceTypes": "Array<EnumProperty> \u2014 list of trailer-bay categories the cargo fits (Tanker, Container, Flatbed, ...).",
      "WeightRange": "Vector2D struct \u2014 (min, max) tonnage range.",
      "InTimeTipRange": "Vector2D struct \u2014 UI tooltip min/max for the timer feature.",
      "GameplayTags": "GameplayTagContainer \u2014 array of FName tags.",
      "ActorClass": "ObjectProperty \u2014 the BP that spawns when the cargo physicalizes. Inherited from copy_from; changing requires new-import resolution.",
      "DumpCargoSurfaceMesh / DumpCargoSurfaceMaterial / DumpPileActorClass": "ObjectProperty \u2014 visuals for dump-truck pile rendering.",
      "Colors": "Array<StructProperty> \u2014 per-cargo color palette for paint variants.",
      "CargoFlags": "Int bitmask \u2014 opaque, intentionally not exposed (no documented bit meanings)."
    }
  },
  "_doc": {
    "purpose": "Per-name delivery-point configuration. Scene placeholders named DeliveryPoint_<KEY> resolve to the entry under <KEY> here. Missing entries are logged and ignored.",
    "naming": "Scene placeholder asset_key 'DeliveryPoint_My_Cool_Spot' looks up KEY 'My_Cool_Spot'. The in-game label defaults to KEY with underscores replaced by spaces ('My Cool Spot'). Any length; the old 14-char cap only applies on the RawExport fallback when the .usmap is stale.",
    "auto_derived": "target_class + target_path are always auto-generated. source_class + source_actor default from the chosen `template` but can be overridden per entry for experimental clones.",
    "validation": "Cargo names + cargo types are cross-checked against CargoImport/cargos/. Invalid names produce a warning and are dropped from that recipe (don't crash the build). new_id values from the new_cargos list count as valid.",
    "fields": {
      "label": "Optional in-game name. Default: KEY with '_' -> ' '. Any length (see naming).",
      "template": "Optional. Selects the vanilla DP class to clone. Default: 'farm' (Farm_Corn_C/CornFarm_2 \u2014 verified end-to-end). Other classes (Container_ExportImport_C, ComonDrop_C, Factory_*) have shown crashes / persistence issues; add new templates to bp_registry._TEMPLATES once validated.",
      "source_class": "Optional override. Bypasses `template` to clone a specific BP class. Experimental \u2014 may not work depending on the class's transitive dependencies.",
      "source_actor": "Optional override. Pairs with source_class. Must name a vanilla instance of source_class that exists in Jeju_World.umap.",
      "recipes": "List of production configs. See _example below for every supported field.",
      "marker_color": "RESERVED. Hex color for the world-map marker. Pipeline propagates the value but MTBPInjector mutation is not yet wired (see AGENTS.md 'Marker / Icon Mutation (Pending)').",
      "icon": "RESERVED. /Game/... path for the marker icon. Same plumbing status as marker_color.",
      "output_storage_cap": "RESERVED. Per-cargo max storage on this delivery point (vanilla default ~100). Lives on a separate MTDeliveryPointInventoryRatio actor, not on the BP CDO \u2014 needs targeted mutation. Pipeline propagates the value but MTBPInjector mutation pending."
    },
    "recipe_fields": {
      "inputs": "{Cargo: Count} \u2014 specific cargo names. Vanilla names from cargos/cargo_names.txt OR new_id values from the new_cargos list above.",
      "outputs": "{Cargo: Count} \u2014 same shape as inputs.",
      "input_types": "[Type] OR {Type: Count} \u2014 EDeliveryCargoType filter from cargos/types.txt. Accepts ANY cargo of that type.",
      "output_types": "[Type] OR {Type: Count} \u2014 same shape as input_types.",
      "speed": "Float \u2014 ProductionSpeedMultiplier (1.0 default; 5.0 = 500%).",
      "time_seconds": "Float \u2014 ProductionTimeSeconds for one production cycle."
    }
  },
