# Build artifacts
MTBPInjector/bin/
MTBPInjector/obj/
__pycache__/
*.pyc

# Packaged mod output — commit the mod folder's mesh assets, but never the
# regenerated main-map artifacts or the .pak itself.
MapChangeTest_P/MotorTown/Content/Maps/
MapChangeTest_P.pak
mod_pak.pak
MapChangeTest_P_backup_*.pak

# Delivery-point BPs are regenerated every build (clean wipes the folder,
# clone_bp_actors rebuilds the Mod* classes + vanilla safety-net overrides),
# so tracking them just churns the tree. They're build artifacts.
MapChangeTest_P/MotorTown/Content/Objects/Mission/Delivery/DeliveryPoint/

# Stray Unreal asset artifacts at the repo root (pipeline scratch) — allow
# them only inside the mod folder where they are the actual deliverable.
*.uasset
*.uexp
*.ubulk
*.umap
*.pak.backup
!MapChangeTest_P/**/*.uasset
!MapChangeTest_P/**/*.uexp
!MapChangeTest_P/**/*.ubulk
!MapChangeTest_P/**/*.umap

# Editor-exported scene data, not framework. ue.py regenerates it from the
# live editor each run; it's large (foliage-heavy) staged data, so it's not
# tracked. Run ue.py in the editor to produce it locally before building.
# ue.py now writes sharded JSONL (static_meshes_parts/); the single-file
# form is kept for legacy/hand-authored exports.
static_meshes.json
static_meshes_parts/

# Pipeline intermediates now live in the temp work dir (mt_paths.WORK_DIR,
# default %TEMP%\MTMapInjector), not the repo. map_work_changes.json is
# generated from static_meshes.json each run — no longer tracked.
map_work_changes.json
Jeju_World*.json
cell*.json
tmp_*.json
tmp_*.uexp
tmp_*.umap
tmp_*.uasset
test_*.json
BPITA*.json
pk.u*
*.log

# Misc archives / extracted content
*.zip
uassetgui_out.txt

# IDE / tooling state
.claude/
.vs/
.idea/
*.user

# RE-UE4SS and MotorTownMods (reference clones, not part of this mod)
RE-UE4SS/
MotorTownMods/

# Auto-picker cache for vanilla WP template cell — local to each clone
clone_bp_actors.template_cache

# User-specific configuration (paths to game install / .usmap). Ships
# as `.env.example` instead — copy and edit per machine.
.env

# Vanilla map bulk data moved out of the mod pak (it ships in the game pak
# already; the mod relies on that copy). Recoverable, not tracked.
_ubulk_backup/

# Bootstrap-extracted vanilla content lives entirely inside the repo so
# the pipeline doesn't depend on any external extraction tool, but it's
# ~hundreds of MB of game files, never commit it.
vanilla_extract/


# Foliage-probe scratch dumps (raw Extras blobs, roundtrip cell writes).
# Regenerated by dump-extras / reencode-foliage on demand.
_fb/
_fol2/
_rt/

# Project backup archives (multi-GB, created on demand).
backups/
# pack_vehicles.py staging dirs and standalone paks (build output)
TankersFuelPump_P/
TankersFuelPump_CapitalistEconomy_P/
TankersFuelPump*.pak
ZZZZZ_TankersFuelPump_Arini_P/

# Build output. The staged mod tree and every pak it produces are rebuilt
# from source by build.bat, so tracking them bought nothing and cost 22.5 GB
# of pak blobs across 63 commits -- past GitHub's 100 MB per-file limit,
# which is what left this repo unpushed.
/Arini_P/
*.pak
/T_WorldMap_Jeju.png
